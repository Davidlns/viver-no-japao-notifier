# YouTube Data API v3 key (Google Cloud Console)
YOUTUBE_API_KEY=

# ID do canal do YouTube (começa com "UC...")
YOUTUBE_CHANNEL_ID=

# Webhook do canal #🎥-vídeos-novos (usado pelo checker do YouTube)
DISCORD_WEBHOOK_URL_VIDEOS=

# Webhook do canal #📰-notícias (reservado pros futuros checkers NHK/Portal Mie)
DISCORD_WEBHOOK_URL_NEWS=

# Opcional: texto que vai antes do link no Discord.
# Suporta menções tipo <@&ROLE_ID> ou @everyone.
# Ex.: "Vídeo novo no ar! @everyone"
DISCORD_MESSAGE_PREFIX=Vídeo novo no ar!

# Opcional: caminho do arquivo de estado (default: last_video.json ao lado do script)
# STATE_FILE=last_video.json

# --- Usado só pelos scripts em admin/ (ações administrativas: criar canal, cor de cargo, etc.) ---
# Bot Token do Discord Developer Portal. NUNCA commitar. Mais poderoso que o webhook acima.
DISCORD_BOT_TOKEN=

# ID do servidor (botão direito no nome do servidor > Copiar ID do Servidor, com Modo Desenvolvedor ativado)
DISCORD_GUILD_ID=
